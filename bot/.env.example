# Bot token (BotFather dan oling)
BOT_TOKEN=your_bot_token_here

# Admin ID lar (vergul bilan ajrating)
ADMIN_IDS=6998664132

# Backup kanal ID (videolar saqlanadi, masalan: -1001234567890)
BACKUP_CHANNEL_ID=-1001234567890

# Majburiy obuna kanallari (vergul bilan ajrating, masalan: @channel1,@channel2)
REQUIRED_CHANNELS=@your_channel

# Flask port (Render avtomatik beradi)
PORT=8000

# Reklama intervali (necha qidiruvdan keyin)
AD_INTERVAL=10
